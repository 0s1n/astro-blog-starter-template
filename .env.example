# Cloudflare API Configuration
# These environment variables are used for authentication with Cloudflare
# when deploying with Wrangler. This is especially useful in CI/CD environments
# or when you encounter GNOME keyring errors.

# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Recommended: Create a token with "Edit Cloudflare Workers" permissions
CLOUDFLARE_API_TOKEN=your-api-token-here

# Get your Account ID from: https://dash.cloudflare.com/
# Look for "Account ID" in the right sidebar of any Workers or Pages project
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# Optional: Disable keyring usage if you encounter GNOME keyring errors
# Uncomment the line below if needed:
# XDG_SESSION_TYPE=tty

# Note: Never commit your actual .env file with real tokens to version control!
# Add .env to your .gitignore file.
